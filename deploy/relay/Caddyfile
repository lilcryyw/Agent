# Ретранслятор на российском VPS: если основной сервер во Франции недоступен из России
# (блокировки зарубежных хостингов, «белые списки» мобильного интернета), родные подключаются сюда.
# Трафик зашифрован целиком (HTTPS/WSS); ретранслятор ничего не хранит и не видит паролей.
{$RELAY_DOMAIN} {
    reverse_proxy https://{$JARVIS_DOMAIN} {
        header_up Host {$JARVIS_DOMAIN}
        transport http {
            tls_server_name {$JARVIS_DOMAIN}
        }
    }
}
