# HTTPS сертификат Caddy получает сам (Let's Encrypt). Домен — в .env: JARVIS_DOMAIN.
{$JARVIS_DOMAIN} {
    # Устройства (ПК, телефоны) подключаются сюда по WebSocket; здесь же скачивается клиент.
    handle /devices* {
        reverse_proxy jarvis:8765
    }
    # Вход для iPhone (Команды Siri), веб-приложения и автоматизаций.
    handle /api* {
        reverse_proxy jarvis:8780
    }
    respond "Джарвис на связи" 200
}
