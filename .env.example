# --- Обязательно ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Владелец ---
JARVIS_OWNER_ID=owner
JARVIS_OWNER_NAME=Владимир
JARVIS_OWNER_TZ=Europe/Paris

# Члены семьи: id:Имя:роль:часовой пояс, через «;»
JARVIS_PEOPLE=mama:Ольга Петровна:family:Europe/Samara

# --- Модели ---
# «Сознание». claude-sonnet-5-5 — примерно вдвое дешевле.
JARVIS_BRAIN_MODEL=claude-opus-5-5
# Глубина размышлений: low | medium | high
JARVIS_BRAIN_EFFORT=medium
# «Подсознание» — фоновая работа памяти.
JARVIS_SUBCONSCIOUS_MODEL=claude-haiku-5-5
# Модель смыслов (локальная). Легче, но слабее: sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
JARVIS_EMBED_MODEL=intfloat/multilingual-e5-large

# --- Деньги: жёсткий лимит в месяц ---
JARVIS_MONTHLY_BUDGET_USD=40

# --- Telegram (для отладки и текста) ---
TELEGRAM_BOT_TOKEN=
JARVIS_TELEGRAM_USERS=123456789:owner,987654321:mama

# --- Мастерская (где Джарвис выполняет свой код) ---
# Любая длинная случайная строка; общая для jarvis и workshop.
JARVIS_WORKSHOP_TOKEN=поменяй-на-длинную-случайную-строку
# Ключ сейфа секретов (Fernet). Пусто — создастся в data/vault.key.
JARVIS_VAULT_KEY=

# --- Устройства ---
# Домен сервера (A-запись на IP VPS). Устройства подключаются к wss://ДОМЕН/devices
JARVIS_DOMAIN=jarvis.example.com
